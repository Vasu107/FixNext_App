{
  "expo": {
    "name": "FixNext",
    "slug": "fixnext",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/FixNext_logo.png",
    "scheme": "fixnext",
    "userInterfaceStyle": "automatic",

    "ios": {
      "supportsTablet": true
    },

    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/FixNext_logo.png"
      },
      "package": "com.vasudev3107.fixnext"
    },

    "web": {
      "output": "static",
      "favicon": "./assets/FixNext_logo.png"
    },

    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/FixNext_logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },

    "extra": {
      "router": {},
      "eas": {
        "projectId": "f246f56f-5513-4d8b-9f39-7b03403f1451"
      }
    }
  }
}