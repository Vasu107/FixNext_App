# FixNext Frontend Environment Variables
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api
# Google OAuth — get from Google Cloud Console > APIs & Services > Credentials
# Web Client ID (required for all platforms via Expo auth proxy)
EXPO_PUBLIC_GOOGLE_CLIENT_ID=329842045868-4dn6e4gp9imos05fb7ciu4m4p6cnfoh0.apps.googleusercontent.com
# Android Client ID (create an Android OAuth credential in Google Cloud Console)
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=329842045868-1p42hmrvnp1254ttvtmvjqgi5vlrl7pg.apps.googleusercontent.com

# iOS Client ID (create an iOS OAuth credential in Google Cloud Console)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=YOUR_GOOGLE_IOS_CLIENT_ID_HERE
